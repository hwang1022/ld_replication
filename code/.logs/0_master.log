. do "$analysis_code/figures/figure_j_disruption_effect_robustness.do"

. clear all

. set more off

. 
. 
. cap mkdir "$output"

. cap mkdir "$output/figures"

. 
. local shocks_table2 "$temp/shocks_dataset_table2.dta"

. 
. use "`shocks_table2'", clear

. 
. capture confirm variable standid

. if _rc {
.         egen standid = group(stand)
. }

. 
. capture confirm variable treat

. if _rc {
.         gen treat = treatment
. }

. 
. eststo clear

. forval current_stand = 1/12 {
  2.         capture noisily reg attend_nadj treat treatXpost_attend_j post_att
> end_j attend_week ///
>                 bl_attend bl_earn miss_bl_earn bl_modalwage week_in_dm i.stan
> did i.strata i.calendar_week ///
>                 if phase==2 & firstwk_attend_j==0 & standid!=`current_stand',
>  vce(cluster standid)
  3.         if _rc continue
  4. 
.         capture noisily boottest {treat} {treatXpost_attend_j}, seed(123) rep
> s(2048) boottype(wild) nograph level(90)
  5.         local used_boottest = (_rc == 0)
  6. 
.         matrix pval = J(1,2,.)
  7.         matrix colnames pval = treat treatXpost_attend_j
  8. 
.         matrix lb = J(1,2,.)
  9.         matrix colnames lb = treat treatXpost_attend_j
 10.         matrix ub = J(1,2,.)
 11.         matrix colnames ub = treat treatXpost_attend_j
 12. 
.         if `used_boottest' {
 13.                 matrix pval[1,1] = r(p_1)
 14.                 matrix pval[1,2] = r(p_2)
 15.                 forv i = 1/2 {
 16.                         local ci_clean_`i' = r(CIstr_`i')
 17.                         if regexmatch("`ci_clean_`i''", "\[([^,]+),") {
 18.                                 local temp1_`i' = regexcapture(1)
 19.                                 local temp1_`i' = subinstr("`temp1_`i''", 
> "−", "-", .)
 20.                         }
 21.                         if regexmatch("`ci_clean_`i''", ",\s*([^\]]+)\]") 
> {
 22.                                 local temp2_`i' = regexcapture(1)
 23.                                 local temp2_`i' = subinstr("`temp2_`i''", 
> "−", "-", .)
 24.                         }
 25.                         matrix lb[1,`i'] = real("`temp1_`i''")
 26.                         matrix ub[1,`i'] = real("`temp2_`i''")
 27.                 }
 28.         }
 29.         else {
 30.                 matrix pval[1,1] = r(table)[4,1]
 31.                 matrix pval[1,2] = r(table)[4,2]
 32.                 scalar zcrit = invnormal(0.95)
 33.                 matrix lb[1,1] = _b[treat] - zcrit * _se[treat]
 34.                 matrix ub[1,1] = _b[treat] + zcrit * _se[treat]
 35.                 matrix lb[1,2] = _b[treatXpost_attend_j] - zcrit * _se[tre
> atXpost_attend_j]
 36.                 matrix ub[1,2] = _b[treatXpost_attend_j] + zcrit * _se[tre
> atXpost_attend_j]
 37.         }
 38. 
.         eststo reg_`current_stand' : reg attend_nadj treat treatXpost_attend_
> j post_attend_j attend_week ///
>                 bl_attend bl_earn miss_bl_earn bl_modalwage week_in_dm i.stan
> did i.strata i.calendar_week ///
>                 if phase==2 & firstwk_attend_j==0 & standid!=`current_stand'
 39.         estadd local calweek "Yes", replace
 40.         estadd local weekin  "Yes", replace
 41.         estadd matrix pval
 42.         estadd matrix lb
 43.         estadd matrix ub
 44. }
note: miss_bl_earn omitted because of collinearity.
note: 44.calendar_week omitted because of collinearity.
note: 47.calendar_week omitted because of collinearity.

