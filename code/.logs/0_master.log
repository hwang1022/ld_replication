.         matrix pval = J(1,3,.)
  4.         matrix colnames pval = treat treatXpost_attend_j treatXweek_in_dm
  5.         matrix pval[1,1] = r(p_1)
  6.         matrix pval[1,2] = r(p_2)
  7.         matrix pval[1,3] = r(p_3)
  8. 
.         eststo: reg attend_nadj treat treatXpost_attend_j post_attend_j atten
> d_week bl_attend ///
