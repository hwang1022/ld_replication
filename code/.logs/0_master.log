. ****
. **## Install Packages
. ****
. 
.         local install_packages = 0

.         if `install_packages' == 1 {
.                 local packagelist baltab strclean
.                 foreach package in `packagelist' {
  2.                         cap net uninstall `package'
  3.                         net install `package', from(https://raw.githubuser
> content.com/haowang5/stata/main/) replace
  4.         }
. 
.         ssc install ietoolkit, replace
.         ssc install grstyle, replace
