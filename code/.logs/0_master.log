. ************************************************************
. ** 3. Phase 2 shock datasets
. **
. ** These datasets measure low-attendance shocks using
. ** leave-one-worker-out stand attendance. The programs below
. ** keep the repeated mechanics in one documented place.
. ************************************************************
. 
. cap program drop add_phase_week_vars

. program define add_phase_week_vars
  1.         /*
>         Create phase-week identifiers and treatment interactions used by
>         the Phase 2 shock specifications.
>         */
.         capture drop stand_ph_calweek_id1 stand_ph_calweek week_in_dm ///
>                 treatXweek_in_dm treatXweek_in treatXpostweek5
  2.         sort standid phase calendar_week date pid
  3.         by standid phase calendar_week: gen stand_ph_calweek_id1 = 1 if _n
>  == 1
  4.         egen temp2 = seq() if stand_ph_calweek_id1 == 1, by(standid phase)
  5.         egen stand_ph_calweek = max(temp2), by(standid phase calendar_week
> )
  6.         drop temp*
  7. 
.         egen temp1 = mean(week_in) if dow == 1, by(pid phase)
  8.         egen temp2 = max(temp1), by(pid phase)
  9.         gen week_in_dm = week_in - temp2
 10.         drop temp*
 11. 
.         gen treatXweek_in_dm = treat * week_in_dm
 12.         gen treatXweek_in = treat * week_in
 13.         gen treatXpostweek5 = treat * (week_in >= 5)
 14. end

. 
. cap program drop gen_loo_attendance_loop

. program define gen_loo_attendance_loop
  1.         /*
>         For each worker, calculate the average residual attendance of
>         other workers at the same stand-week. This reproduces the legacy
>         loop used by the replication code and is kept as a program because
>         the same leave-one-out construction is reused across several shock
>         dataset variants.
>         */
.         syntax, Phase(integer)
  2.         capture drop pid2 avg_wkattend_loo tag_stand_pid2_calweek lag1avg_
> wkattend_loo templag
  3.         egen pid2 = group(standid pid)
  4.         gen avg_wkattend_loo = .
  5.         forvalues s = 1/11 {
  6.                 quietly summ pid2 if standid == `s'
  7.                 forvalues i = `r(min)'/`r(max)' {
  8.                         quietly egen temp1 = mean(resid_day_attendph2) if 
> standid == `s' & pid2 != `i' & phase == `phase', by(standid calendar_week)
  9.                         quietly egen temp2 = max(temp1) if phase == `phase
> ', by(standid calendar_week)
 10.                         quietly replace avg_wkattend_loo = temp2 if pid2 =
> = `i'
 11.                         drop temp*
 12.                 }
 13.         }
 14.         gen treatXavg_wkattend_loo = treat * avg_wkattend_loo
 15.         sort standid pid2 calendar_week date
 16.         by standid pid2 calendar_week: gen tag_stand_pid2_calweek = 1 if _
> n == 1
 17.         sort tag_stand_pid2_calweek standid pid2 calendar_week date
 18.         by tag_stand_pid2_calweek standid pid2: gen templag = avg_wkattend
> _loo[_n - 1] if tag_stand_pid2_calweek == 1 & phase <= `phase'
 19.         egen lag1avg_wkattend_loo = max(templag), by(pid2 calendar_week)
 20. end

. 
. cap program drop add_shock_timing

. program define add_shock_timing
  1.         /*
>         Turn leave-one-out attendance into first-shock, post-shock, and
>         one-week/two-plus-week post-shock indicators. The alias25 option
>         creates the historical variable names consumed by Table 2.
>         */
.         syntax, Threshold(real) [Strict Alias25]
  2. 
.         _pctile avg_wkattend_loo if avg_wkattend_loo != . & dow == 2, p(`thre
> shold')
  3.         scalar pct_j_attend = r(r1)
  4.         if "`strict'" != "" {
  5.                 gen wkof_attend_j = (avg_wkattend_loo < pct_j_attend) if a
> vg_wkattend_loo != .
  6.         }
  7.         else {
  8.                 gen wkof_attend_j = (avg_wkattend_loo <= pct_j_attend) if 
> avg_wkattend_loo != .
  9.         }
 10. 
.         gen calwk_of_shock = stand_ph_calweek if wkof_attend_j == 1
 11.         bys pid: egen firstofshock_calwk_j = min(calwk_of_shock)
 12.         drop calwk_of_shock
 13. 
.         gen wks_since_shock_j = stand_ph_calweek - firstofshock_calwk_j
 14.         replace wks_since_shock_j = . if firstofshock_calwk_j == .
 15. 
.         gen firstwk_attend_j = (wks_since_shock_j == 0)
 16. 
.         gen post_attend_j = (wks_since_shock_j > 0 & !mi(wks_since_shock_j))
 17.         gen treatXpost_attend_j = treatment * post_attend_j
 18. 
.         gen attend_j_post1 = (wks_since_shock_j == 1)
 19.         gen treatXattend_j_post1 = treatment * attend_j_post1
 20. 
.         gen attend_j_post2p = (wks_since_shock_j >= 2 & !mi(wks_since_shock_j
> ))
 21.         gen treatXattend_j_post2p = treatment * attend_j_post2p
 22. 
.         gen shock_threshold = `threshold'
 23.         label var shock_threshold "Shock Threshold"
 24. 
.         if "`alias25'" != "" {
 25.                 gen firstwk_attendloo_b25 = firstwk_attend_j
 26.                 gen treatXfirstwk_attendloo_b25 = treatment * firstwk_atte
> ndloo_b25
 27.                 gen post_attendloo_b25 = post_attend_j
 28.                 gen treatXpost_attendloo_b25 = treatXpost_attend_j
 29.                 gen attendloo25_post1 = attend_j_post1
 30.                 gen treatXattendloo25_post1 = treatXattend_j_post1
 31.                 gen attendloo25_post2p = attend_j_post2p
 32.                 gen treatXattendloo25_post2p = treatXattend_j_post2p
 33.         }
 34. end

