.         cap program drop        makeLaunchList  

.         program define          makeLaunchList, rclass
  1. 
.                 syntax, [launchSet(str)]
  2.                 
.                 local SetNum = wordcount("`launchSet'")
  3.                 
.                 local LaunchSetList
  4.                 
.                 forval v = 1/`SetNum' {
  5.                         if `v' == 1 {
  6.                                 local thisVar : word 1 of `launchSet'
  7.                                 local LaunchSetList " `thisVar' "
  8.                         }
  9.                         else {
 10.                                 local thisVar : word `v' of `launchSet'   
>       
 11.                                 local LaunchSetList " `LaunchSetList' , `t
> hisVar' "
 12.                         }
 13.                 }
 14.                 return local List = "`LaunchSetList'"
 15. 
.         end     

