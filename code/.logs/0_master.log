.         cap program drop otherspec 

.         program define otherspec 
  1. 
.                 syntax varlist(min=2 max=2) , SPECify(string) CATegory(intege
> r) [NEWCATegory(string)]
  2.                 
.                 local catvar : word 1 of `varlist'
  3.                 local othvar : word 2 of `varlist'
  4.                 
.                 tempvar hasstr
  5.                 gen `hasstr' = strpos(`othvar', `"`specify'"') > 0
  6.                 sum `hasstr'
  7.                 
.                 replace `catvar'        = `category'    if `hasstr' == 1
  8.                 replace `othvar'        = ""                    if `hasstr
> ' == 1
  9.                 
.                 if `"`newcategory'"' != "" {
 10.                         qui elabel list (`catvar')
 11.                         label define `r(name)' `category' `"`newcategory'"
> ' , modify
 12.                 }
 13.                 
.         end

.         
