. ***************************************
. **# 2. Generate Percentile Indicators
. ***************************************
. 
.         cap prog drop gen_percentile_indicator

.         prog define gen_percentile_indicator
  1. 
.                 syntax varname(numeric) , percentile(real) newvar(name)
  2. 
.                 bys year: egen cutoff = pctile(`varlist'), p(`percentile')
  3.                 gen `newvar' = `varlist' > cutoff
  4.                 drop cutoff
  5. 
.                 local vlab : var label `varlist'
  6.                 if "`vlab'" == "" local vlab "`varlist'"
  7.                 label var `newvar' "Indicator: `vlab' > `percentile'th per
> centile (within sample/group)"
  8. 
.         end

. 
. 
. 
.         * Temp Percentage
.         gen_percentile_indicator mean_at_rec , percentile(85) newvar(mean_at_
> rec_85p)
note: label truncated to 80 characters

.         gen_percentile_indicator mean_at_rec , percentile(90) newvar(mean_at_
> rec_90p)
note: label truncated to 80 characters

