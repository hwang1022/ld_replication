. 
.         lab var wc_1 "Slight Drizzle"

.         lab var wc_2 "Moderate Drizzle"

.         lab var wc_3 "Heavy Drizzle"

.         lab var wc_4 "Slight Rain"

.         lab var wc_5 "Moderate Rain"

.         lab var wc_6 "Heavy Rain"

.         lab var wc_7 "No Rain"

.         lab var wc_rec_1 "Slight Drizzle Recruit"

.         lab var wc_rec_2 "Moderate Drizzle Recruit"

.         lab var wc_rec_3 "Heavy Drizzle Recruit"

.         lab var wc_rec_4 "Slight Rain Recruit"

.         lab var wc_rec_5 "Moderate Rain Recruit"

.         lab var wc_rec_6 "Heavy Rain Recruit"

.         lab var wc_rec_7 "No Rain Recruit"

. 
. 
.         egen wc_geq_1 = rowtotal(wc_1-wc_6)

.         egen wc_geq_2 = rowtotal(wc_2-wc_6)

.         egen wc_geq_3 = rowtotal(wc_3-wc_6)

.         egen wc_geq_4 = rowtotal(wc_4-wc_6)

.         egen wc_geq_5 = rowtotal(wc_5-wc_6)

.         egen wc_geq_6 = rowtotal(wc_6-wc_6)

.         lab var wc_geq_1 "At least Slight Drizzle"

.         lab var wc_geq_2 "At least Moderate Drizzle"

.         lab var wc_geq_3 "At least Heavy Drizzle"

.         lab var wc_geq_4 "At least Slight Rain"

.         lab var wc_geq_5 "At least Moderate Rain"

.         lab var wc_geq_6 "At least Heavy Rain"

. 
.         egen wc_geq_1_rec = rowtotal(wc_rec_1-wc_rec_6)

.         egen wc_geq_2_rec = rowtotal(wc_rec_2-wc_rec_6)

.         egen wc_geq_3_rec = rowtotal(wc_rec_3-wc_rec_6)

.         egen wc_geq_4_rec = rowtotal(wc_rec_4-wc_rec_6)

.         egen wc_geq_5_rec = rowtotal(wc_rec_5-wc_rec_6)

.         egen wc_geq_6_rec = rowtotal(wc_rec_6-wc_rec_6)

.         lab var wc_geq_1_rec "At least Slight Drizzle Recruit"

.         lab var wc_geq_2_rec "At least Moderate Drizzle Recruit"

.         lab var wc_geq_3_rec "At least Heavy Drizzle Recruit"

.         lab var wc_geq_4_rec "At least Slight Rain Recruit"

.         lab var wc_geq_5_rec "At least Moderate Rain Recruit"

.         lab var wc_geq_6_rec "At least Heavy Rain Recruit"

. 
.         gen __RAIN_CODE_____ = .
(140,624 missing values generated)

.         order __RAIN_CODE_____ , after (accu_prec_rec_99p)

. 
. 
. 
. 
. ************************
. **# 4. Rolling Average
. ************************
. 
.         xtset stand date

Panel variable: stand (strongly balanced)
 Time variable: date, 01jan1990 to 31dec2024
         Delta: 1 day

.         foreach i of varlist mean_at mean_at_rec max_at max_at_rec accu_prec 
> accu_prec_rec {
  2.                 tssmooth ma `i'_r3 = `i', window(2 1 0)
  3.                 tssmooth ma `i'_r4 = `i', window(3 1 0)
  4.                 tssmooth ma `i'_r5 = `i', window(4 1 0)
  5.                 tssmooth ma `i'_r6 = `i', window(5 1 0)
  6.                 tssmooth ma `i'_r7 = `i', window(6 1 0)
  7.                 lab var `i'_r3 "`i' 3-Day Rolling: `i'"
  8.                 lab var `i'_r4 "`i' 4-Day Rolling: `i'"
  9.                 lab var `i'_r5 "`i' 5-Day Rolling: `i'"
 10.                 lab var `i'_r6 "`i' 6-Day Rolling: `i'"
 11.                 lab var `i'_r7 "`i' 7-Day Rolling: `i'"
 12. 
.                 gen_percentile_indicator `i'_r3 , percentile(85) newvar(`i'_r
> 3_85p)
 13.                 gen_percentile_indicator `i'_r3 , percentile(90) newvar(`i
> '_r3_90p)
 14.                 gen_percentile_indicator `i'_r3 , percentile(95) newvar(`i
> '_r3_95p)
 15.                 gen_percentile_indicator `i'_r3 , percentile(99) newvar(`i
> '_r3_99p)
 16.                 gen_percentile_indicator `i'_r4 , percentile(85) newvar(`i
> '_r4_85p)
 17.                 gen_percentile_indicator `i'_r4 , percentile(90) newvar(`i
> '_r4_90p)
 18.                 gen_percentile_indicator `i'_r4 , percentile(95) newvar(`i
> '_r4_95p)
 19.                 gen_percentile_indicator `i'_r4 , percentile(99) newvar(`i
> '_r4_99p)
 20.                 gen_percentile_indicator `i'_r5 , percentile(85) newvar(`i
> '_r5_85p)
 21.                 gen_percentile_indicator `i'_r5 , percentile(90) newvar(`i
> '_r5_90p)
 22.                 gen_percentile_indicator `i'_r5 , percentile(95) newvar(`i
> '_r5_95p)
 23.                 gen_percentile_indicator `i'_r5 , percentile(99) newvar(`i
> '_r5_99p)
 24.                 gen_percentile_indicator `i'_r6 , percentile(85) newvar(`i
> '_r6_85p)
 25.                 gen_percentile_indicator `i'_r6 , percentile(90) newvar(`i
> '_r6_90p)
 26.                 gen_percentile_indicator `i'_r6 , percentile(95) newvar(`i
> '_r6_95p)
 27.                 gen_percentile_indicator `i'_r6 , percentile(99) newvar(`i
> '_r6_99p)
 28.                 gen_percentile_indicator `i'_r7 , percentile(85) newvar(`i
> '_r7_85p)
 29.                 gen_percentile_indicator `i'_r7 , percentile(90) newvar(`i
> '_r7_90p)
 30.                 gen_percentile_indicator `i'_r7 , percentile(95) newvar(`i
> '_r7_95p)
 31.                 gen_percentile_indicator `i'_r7 , percentile(99) newvar(`i
> '_r7_99p)
 32. 
.                 lab var `i'_r3_85p "3-Day Rolling: `i' 85p"
 33.                 lab var `i'_r3_90p "3-Day Rolling: `i' 90p"
 34.                 lab var `i'_r3_95p "3-Day Rolling: `i' 95p"
 35.                 lab var `i'_r3_99p "3-Day Rolling: `i' 99p"
 36.                 lab var `i'_r4_85p "4-Day Rolling: `i' 85p"
 37.                 lab var `i'_r4_90p "4-Day Rolling: `i' 90p"
 38.                 lab var `i'_r4_95p "4-Day Rolling: `i' 95p"
 39.                 lab var `i'_r4_99p "4-Day Rolling: `i' 99p"
 40.                 lab var `i'_r5_85p "5-Day Rolling: `i' 85p"
 41.                 lab var `i'_r5_90p "5-Day Rolling: `i' 90p"
 42.                 lab var `i'_r5_95p "5-Day Rolling: `i' 95p"
 43.                 lab var `i'_r5_99p "5-Day Rolling: `i' 99p"
 44.                 lab var `i'_r6_85p "6-Day Rolling: `i' 85p"
 45.                 lab var `i'_r6_90p "6-Day Rolling: `i' 90p"
 46.                 lab var `i'_r6_95p "6-Day Rolling: `i' 95p"
 47.                 lab var `i'_r6_99p "6-Day Rolling: `i' 99p"
 48.                 lab var `i'_r7_85p "7-Day Rolling: `i' 85p"
 49.                 lab var `i'_r7_90p "7-Day Rolling: `i' 90p"
 50.                 lab var `i'_r7_95p "7-Day Rolling: `i' 95p"
 51.                 lab var `i'_r7_99p "7-Day Rolling: `i' 99p"
 52.         }
