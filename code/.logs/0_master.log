. bys standid phase (date pid): egen start_calendar_week = min(calendar_week)

. bys standid phase (date pid): gen stand_ph_calweek = calendar_week - start_ca
> lendar_week + 1

. gen treatXstand_ph_calweek = treatment * stand_ph_calweek

