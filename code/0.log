.         
.         forvalues i = 1/14 {
  2.                 forvalues j = 1/7 {
  3.                         
.                         * Gen Main Var
.                         cap gen time_activity_`i'_`j' = "0"
  4.                         replace time_activity_`i'_`j' = "" if mi(time_acti
> vity_1_`j')
  5.                         destring time_activity_`i'_`j' , replace
  6.                         
.                         * Handle Others
.                         gen act = lower(trim(time_activity_others_`j'))
  7.                         replace time_activity_`i'_`j'  = 1 if inlist(act, 
> ///
>                                 "my daughter is tuition center pickup", ///
>                                 "droped mom for", ///
>                                 "droped mom for job") & `i' == 5
  8.                         replace time_activity_`i'_`j'  = 1 if act == "bath
> ing" & `i' == 6
  9.                         replace time_activity_`i'_`j'  = 1 if act == "usin
> g phone" & `i' == 9
 10.                         replace time_activity_`i'_`j' = 1 if inlist(act, "
> going to work", "walking") & `i' == 10
 11.                         replace time_activity_`i'_`j' = 1 if act == "summa
> dha irupe" & `i' == 11
 12.                         replace time_activity_`i'_`j' = 1 if act == "waiti
> ng for job" & `i' == 12
 13.                         replace time_activity_`i'_`j' = 1 if inlist(act, /
> //
>                                 "house cleaning", ///
>                                 "washing the vehicle", ///
>                                 "i do watering and milking of cows", ///
>                                 "gardening", ///
>                                 "dishes wash") & `i' == 13
 14.                         replace time_activity_`i'_`j' = 1 if inlist(act, /
> //
>                                 "drinking tea", ///
>                                 "watching tv", ///
>                                 "tv parpathu", ///
>                                 "tv", ///
>                                 "tea sapiduvadhu", ///
>                                 "tea poduvadhu", ///
>                                 "tea shop", ///
>                                 "watching news") & `i' == 14
 15.                         drop act
 16.                         
.                         * Adjusted for other
.                         cap gen time_activity_adj_`i'_`j' = time_activity_`i'
> _`j'
 17.                         if `i' <= 12 replace time_activity_adj_`i'_`j' = a
> ctivity_other_`i'_`j' if !mi(activity_other_`i'_`j')
 18.                         
.                         
.                         * Labels
.                         local activity_lab ""
 19.                         if `i' == 1  local activity_lab "1. Get water"
 20.                         if `i' == 2  local activity_lab "2. Cook breakfast
> "
 21.                         if `i' == 3  local activity_lab "3. Eat breakfast"
 22.                         if `i' == 4  local activity_lab "4. Help get kids 
> ready for school"
 23.                         if `i' == 5  local activity_lab "5. Drop kids at s
> chool"
 24.                         if `i' == 6  local activity_lab "6. Wash / bathe"
 25.                         if `i' == 7  local activity_lab "7. Go to temple /
>  prayers / meditate"
 26.                         if `i' == 8  local activity_lab "8. Go to the stor
> e / shop"
 27.                         if `i' == 9  local activity_lab "9. Call employers
>  / friends to find a job"
 28.                         if `i' == 10 local activity_lab "10. Traveling"
 29.                         if `i' == 11 local activity_lab "11. Sleep / rest"
 30.                         if `i' == 12 local activity_lab "12. Be at the sta
> nd / search for work"
 31.                         if `i' == 13 local activity_lab "13. Home producti
> on (chores, livestock care, etc.)"
 32.                         if `i' == 14 local activity_lab "14. Entertainment
>  (drinking tea, watching TV, etc.)"
 33.     
.                         local time_lab ""
 34.                         if `j' == 1  local time_lab "5:30-6:00am"
 35.                         if `j' == 2  local time_lab "6:00-6:30am"
 36.                         if `j' == 3  local time_lab "6:30-7:00am"
 37.                         if `j' == 4  local time_lab "7:00-7:30am"
 38.                         if `j' == 5  local time_lab "7:30-8:00am"
 39.                         if `j' == 6  local time_lab "8:00-8:30am"
 40.                         if `j' == 7  local time_lab "8:30-9:00am"
 41.                         
.                         lab var time_activity_`i'_`j'           "Activity at 
> `time_lab': `activity_lab'"
 42.                         lab var time_activity_adj_`i'_`j'       "Adj Activ
> ity (Incl. Weak) at `time_lab': `activity_lab'"
 43.                 }
 44.                 
.                 * Main Total
.                 egen time_activity_tot_`i' = rowtotal(time_activity_`i'_*) , 
> missing
 45.                 egen time_activity_adj_tot_`i' = rowtotal(time_activity_ad
> j_`i'_*) , missing
 46.                 
.                 lab var time_activity_tot_`i'           "Activity: `activity_
> lab'"
 47.                 lab var time_activity_adj_tot_`i'       "Adj Activity (Inc
> l. Weak): `activity_lab'"
 48.         }
