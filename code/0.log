.         
.         * Create Lagged Weather
.         foreach i of varlist max_at max_at_rec accu_prec accu_prec_rec {
  2.                 foreach rolling_num in 3 4 5 6 7 {
  3. 
.                         gen `i'_r`rolling_num'_l0 = `i'_r`rolling_num'
  4.                         lab var `i'_r`rolling_num'_l0 "`rolling_num'-Day R
> olling: `i' (L0)"
  5. 
.                         forvalues l = 1/7 {
  6.                                 bys stand (date) : gen `i'_r`rolling_num'_
> l`l' = L`l'.`i'_r`rolling_num'
  7.                                 lab var `i'_r`rolling_num'_l`l' "`rolling_
> num'-Day Rolling: `i' (L`l')"
  8.                         }
  9. 
. 
.                         foreach percentile in 85 90 95 99 {
 10.                                 bys stand (date) : gen `i'_r`rolling_num'_
> `percentile'p_l0 = `i'_r`rolling_num'_`percentile'p
 11.                                 lab var `i'_r`rolling_num'_`percentile'p_l
> 0 "`rolling_num'-Day Rolling: `i' `percentile'p (L0)"
 12. 
.                                 forvalues l = 1/7 {
 13.                                         bys stand (date) : gen `i'_r`rolli
> ng_num'_`percentile'p_l`l' = L`l'.`i'_r`rolling_num'_`percentile'p
 14.                                         lab var `i'_r`rolling_num'_`percen
> tile'p_l`l' "`rolling_num'-Day Rolling: `i' `percentile'p (L`l')"
 15.                                 }
 16.                         }
 17.                 }
 18.         }
