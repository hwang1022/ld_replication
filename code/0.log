. ******************
. **# 1. Read Data
. ******************
. 
. local combine_raw = 1

. 
. if `combine_raw' == 1 {
.         * Get list of all files matching the pattern
.         local files : dir "$external/weather" files "stand_*_*_hourly.csv"
. 
.         * Initialize counter for tempfiles
.         local n = 0
. 
.         * Loop through each file
.         foreach file of local files {
  2.                 // Extract stand number and year from filename using regex
.                 if regexm("`file'", "stand_([0-9]+\.?[0-9]*)_([0-9]+)_hourly\
> .csv") {
  3.                         local stand_num = regexs(1)
  4.                         local year_num = regexs(2)
  5.                         
.                         // Load the dataset
.                         import delimited "$external/weather/`file'", clear
  6.                         
.                         // Add stand and year variables
.                         gen stand = real("`stand_num'")
  7.                         // Save as tempfile
.                         tempfile file`n'
  8.                         save `file`n'', replace
  9.                         
.                         local n = `n' + 1
 10.                 }
 11.         }
