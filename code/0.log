. 
.         
.         * Purpose: auxiliary function saving input in file called 'input.tex'
.         * Author: Unknown
.         * Last modified: Unknown
.         cap program drop save_input 

.         program define save_input 
  1. 
.                 syntax [anything], number(str) filename(str) [format(str)]
  2. 
. 
.                 if "`format'" != "" local number_formatted = string(`number',
>  "`format'")
  3.                 else local number_formatted "`number'"
  4. 
.                 /*
>                 if `number_formatted' >= 0 & `number_formatted' < 1 {
>                         local number_formatted = subinstr("`number_formatted'
> ", "0.", ".", .)
>                 }
>                 if `number_formatted' <= 0 & `number_formatted' > -1 {
>                         local number_formatted = subinstr("`number_formatted'
> ", "-0.", "-.", .)
>                 }
>                 */
. 
.                 file open newfile using "$stats/`filename'.tex", write replac
> e
  5.                 file write newfile "`number_formatted'%"
  6.                 file close newfile
  7.         end

.         
. 
.         * Purpose: Auxiliary function to install any uninstalled ssc packages
>  before using them
.         * Author: Unknown
.         * Last modified: Unknown
.         cap program drop verify_package 

.         program verify_package
  1.                 args package
  2.                 capture which `package'
  3.                 if _rc ssc install `package'
  4.                 if !_rc di "Package `package' already installed in the sys
> tem. Code can proceed."
  5.         end

. 
.         
.         
.         * Purpose: create a local with max number of days of recall
.         * Author: Luisa
.         * Last modified: 09-07-2021 - LC
.         cap program drop        defineRecallDays

.         program define          defineRecallDays, rclass
  1.                 syntax, varname(str)
  2.                 
.                 local i = 1     
  3.                 local rc = 0
  4.                 while `rc' != 1 {
  5.                         capture confirm variable `varname'_`i'
  6.                         if !_rc {
  7.                                 * if this variable does not exist 
.                                 local ++i 
  8.                                         * this increases the local i by va
> lue 1
.                                 local rc = 0
  9.                         }
 10.                         else {
 11.                                 local d = `i' - 1
 12.                                 return local max_days_recall = `d'
 13.                                 disp(`d')
 14.                                 local rc = 1
 15.                         }
 16.                 }
 17.         end

.         
.         
.         
.         * Purpose: Unknown
.         * Author: Luisa
.         * Last modified: Unknown
.         cap program drop        makeDates

.         program define          makeDates, rclass
  1. 
.         syntax, launchDate(str)
  2.         return clear
  3.         tempvar date
  4.         
.         local launchDate_dow = dow(`launchDate')
  5.         assert `launchDate_dow' == 1
  6.         
.         local date = `launchDate'
  7. 
.         local baseline     = `date' + 3
  8.         local baseline_end = `date' + 15
  9.         local announcement = `date' + 16
 10.         local announcement_end_b1  = `date' + 20
 11.         local announcement_end_b2  = `date' + 22
 12.         local announcement_end_b3  = `date' + 22
 13.         
.         // LC 29-04-2024: these dates are now overwritten in the master_dates
> .do
.         // to reflect actual timeline
.         local phase1       = `date' + 21 
 14.         local phase1_end   = `date' + 69
 15.         local phase2       = `date' + 70
 16.         local phase2_end   = `date' + 119
 17. 
. 
.         * Save in r(.)
.         return local baseline     = `baseline'
 18.         return local baseline_end = `baseline_end'
 19.         return local announcement = `announcement'
 20.         return local announcement_end_b1 = `announcement_end_b1'
 21.         return local announcement_end_b2 = `announcement_end_b2'
 22.         return local announcement_end_b3 = `announcement_end_b3'
 23.         return local phase1       = `phase1'
 24.         return local phase1_end   = `phase1_end'
 25.         return local phase2       = `phase2'
 26.         return local phase2_end   = `phase2_end'
 27.                 
