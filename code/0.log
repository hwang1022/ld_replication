> ture During Recruitment Time"

.         label var mean_prec                                             "Mean
>  Precipitation of the day"

.         label var mean_prec_recruit                             "Mean Precipi
> tation During Recruitment Time"

.         label var max_prec                                              "Max 
> Precipitation of the day"

.         label var max_prec_recruit                              "Max Precipit
> ation During Recruitment Time"

.         label var max_weather_code                              "Max Weather 
> Code of the day"

.         label var max_weather_code_recruit              "Max Weather Code Dur
> ing Recruitment Time"

.         label var month                                                 "Mont
> h"

.         label var year                                                  "Year
> "

.         label var month_year                                    "Month Year"

.         label var stand                                                 "Stan
> d"

