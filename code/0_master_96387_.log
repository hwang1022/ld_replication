.         * Purpose: auxiliary function saving input in file called 'input.tex'
.         * Author: Unknown
.         * Last modified: Unknown
.         cap program drop save_input 

.         program define save_input 
  1. 
.                 syntax [anything], number(str) filename(str) [format(str)]
  2. 
. 
.                 if "`format'" != "" local number_formatted = string(`number',
>  "`format'")
  3.                 else local number_formatted "`number'"
  4. 
.                 /*
>                 if `number_formatted' >= 0 & `number_formatted' < 1 {
>                         local number_formatted = subinstr("`number_formatted'
> ", "0.", ".", .)
>                 }
>                 if `number_formatted' <= 0 & `number_formatted' > -1 {
>                         local number_formatted = subinstr("`number_formatted'
> ", "-0.", "-.", .)
>                 }
>                 */
. 
.                 file open newfile using "$stats/`filename'.tex", write replac
> e
  5.                 file write newfile "`number_formatted'%"
  6.                 file close newfile
  7.         end

