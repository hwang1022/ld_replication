.         * Purpose: create a local with max number of days of recall
.         * Author: Luisa
.         * Last modified: 09-07-2021 - LC
.         cap program drop        defineRecallDays

.         program define          defineRecallDays, rclass
  1.                 syntax, varname(str)
  2.                 
.                 local i = 1     
  3.                 local rc = 0
  4.                 while `rc' != 1 {
  5.                         capture confirm variable `varname'_`i'
  6.                         if !_rc {
  7.                                 * if this variable does not exist 
.                                 local ++i 
  8.                                         * this increases the local i by va
> lue 1
.                                 local rc = 0
  9.                         }
 10.                         else {
 11.                                 local d = `i' - 1
 12.                                 return local max_days_recall = `d'
 13.                                 disp(`d')
 14.                                 local rc = 1
 15.                         }
 16.                 }
 17.         end

