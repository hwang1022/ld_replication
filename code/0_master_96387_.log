.         * Generate baseline covariates for original dataset. New datatsets ha
> ve these variables already.
.         * For replicating analysis using the original dataset.
.         * Created by HW in April 2026
.         cap program drop gen_bl_cov

.         program define gen_bl_cov
  1.                 preserve
  2. 
.                         cap drop bl_attend bl_earn miss_bl_earn bl_modalwage
  3. 
.                         keep if phase == 0
  4. 
.                         egen temp = mean(attend), by(pid)
  5.                         egen bl_attend = max(temp), by(pid)
  6.                         drop temp
  7. 
.                         * earnings 
.                         egen temp = mean(earn) , by(pid)
  8.                         egen bl_earn = max(temp), by(pid)
  9.                         gen miss_bl_earn = (bl_earn==.)
 10.                         replace bl_earn = 0 if miss_bl_earn==1
 11.                         drop temp
 12.                         
.                         * Modal Work
.                         egen temp1 = mode(earn) if earn>0, by(pid)
 13.                         egen bl_modalwage = max(temp1), by(pid)
 14.                         replace bl_modalwage = 0 if bl_modalwage==.
 15.                         drop temp1
 16. 
.                         keep pid bl_attend bl_earn miss_bl_earn bl_modalwage
 17.                         duplicates drop pid, force
 18. 
.                         tempfile bl_cov
 19.                         save `bl_cov', replace
 20. 
.                 restore
 21. 
.                 merge m:1 pid using `bl_cov', update replace keep(1 2 3 4 5) 
> nogen
 22. 
. 
.         end

