. ************************************************************
. * PROGRAM: build_shock — exact copy of LC's pipeline.
. *  Input  : data already loaded with `resid_day_attendph2` defined for the
. *           prediction sample of interest (everyone in v0; only treat==0 in v0c).
. *  Output : same shock vars LC builds (firstwk_attend_j, post_attend_j, etc.)
. ************************************************************
. program drop _all

. program define build_shock
  1.         * Aggregate daily residuals to worker-week level
.         preserve
  2.                 keep if phase == 2
  3.                 set type double
  4.                 collapse (sum) w_sum = resid_day_attendph2 ///
>                          (count) w_n = resid_day_attendph2 ///
>                          (first) standid, by(calendar_week pid treat)
  5. 
.                 bys standid calendar_week: egen count_pid = count(pid) if treat == 0
  6.                 bysort standid calendar_week: egen sw_sum = total(w_sum)
  7.                 bysort standid calendar_week: egen sw_n   = total(w_n)
  8.                 sort pid calendar_week
  9.                 gen double avg_wkattend_loo = (sw_sum - w_sum) / (sw_n - w_n)
 10. 
.                 bys pid calendar_week: keep if _n == 1
 11.                 sum avg_wkattend_loo, d
 12.                 scalar pct_j_attend = r(p25)
 13. 
.                 keep pid calendar_week avg_wkattend_loo
 14.                 gen dow = 2
 15.                 tempfile loo_worker_week
 16.                 save `loo_worker_week'
 17.         restore
 18. 
.         merge m:1 pid calendar_week using `loo_worker_week', keep(1 2 3) nogen
 19. 
.         gen wkof_attend_j = (avg_wkattend_loo <= pct_j_attend) if avg_wkattend_loo!=.
 20. 
.         gen calwk_of_shock = stand_ph_calweek if wkof_attend_j==1
 21.         bys pid : egen firstofshock_calwk_j = min(calwk_of_shock)
 22.         drop calwk_of_shock
 23.         gen calwk_of_shock = calendar_week if wkof_attend_j==1
 24.         bys pid : egen firstofshock1_calwk_j = min(calwk_of_shock)
 25.         drop calwk_of_shock
 26. 
.         gen wks_since_shock_j = stand_ph_calweek - firstofshock_calwk_j
 27.         replace wks_since_shock_j = . if firstofshock_calwk_j == .
 28. 
.         gen firstwk_attend_j     = (wks_since_shock_j == 0)
 29.         gen post_attend_j        = (wks_since_shock_j > 0 & !mi(wks_since_shock_j))
 30.         gen treatXfirstwk_attend = treat * firstwk_attend_j
 31.         gen treatXpost_attend    = treat * post_attend_j
 32. end

. 
. 
. ************************************************************
. * SHARED PRELIM (lines 19-42 of LC's script)
. ************************************************************
. program define prelim
  1.         use "$main_data" , clear
  2.         gen treat = treatment
  3.         egen standid = group(stand)
  4.         sort standid phase calendar_week date pid
  5.         by standid phase calendar_week: gen stand_ph_calweek_id1 = 1 if _n==1
  6.         egen temp2 = seq() if stand_ph_calweek_id1 == 1, by(standid phase)
  7.         egen stand_ph_calweek = max(temp2), by(standid phase calendar_week)
  8.         drop temp*
  9.         egen temp1 = mean(week_in) if dow==1, by(pid phase)
 10.         egen temp2 = max(temp1), by(pid phase)
 11.         gen week_in_dm = week_in - temp2
 12.         drop temp*
 13. end

. 
