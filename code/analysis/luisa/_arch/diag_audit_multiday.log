. *================================================================*
. * PART A. PHASE-2 RAW: provenance & conflicts (per recall slot)
. *================================================================*
. use "$temp/03_phase2_completed_cleaned.dta", clear

. 
. local exp_yes 0

. local exp_no  0

. local conflict_no_chan5 0      // explicit=No but v1 channel=multiday(5)

. local fallback_md 0            // explicit missing -> md set by howfound(v1)==5

. local v2_contam 0              // explicit missing & v1 missing & v2==5 (phone-friend misflag)

. forval i = 1/7 {
  2.     cap confirm variable f_multiday_job_`i'
  3.     if _rc continue
  4.     qui count if f_multiday_job_`i'==1
  5.     local exp_yes = `exp_yes' + r(N)
  6.     qui count if f_multiday_job_`i'==0
  7.     local exp_no  = `exp_no'  + r(N)
  8.     qui count if f_multiday_job_`i'==0 & f_howfound_`i'==5     // worker: not multiday, channel(v1): multiday
  9.     local conflict_no_chan5 = `conflict_no_chan5' + r(N)
 10.     qui count if mi(f_multiday_job_`i') & f_howfound_`i'==5    // fallback contributes a multiday
 11.     local fallback_md = `fallback_md' + r(N)
 12.     qui count if mi(f_multiday_job_`i') & mi(f_howfound_`i') & f_howfound_v2_`i'==5  // misflag risk
 13.     local v2_contam = `v2_contam' + r(N)
 14. }

