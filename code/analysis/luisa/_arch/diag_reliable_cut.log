. *--- program: build job_at_stand CORE BLOCK on whatever is in memory ---
. capture program drop buildjas

. program define buildjas
  1.     gen byte grid = !mi(daily_recall_lag)
  2.     gen byte clean_stand = .
  3.     replace clean_stand = 1 if whenfound==2
  4.     replace clean_stand = 0 if inlist(whenfound,1,3)
  5.     replace clean_stand = 0 if mi(clean_stand) & !mi(howfound_notattend) & howfound_notattend!=5
  6.     replace clean_stand = 1 if mi(clean_stand) & inlist(howfound,6,7,8,9,10,11)
  7.     replace clean_stand = 0 if mi(clean_stand) & inlist(howfound,1,2,3,4,998)
  8.     gen byte has_clean = (work==1 & multiday_job==0 & !mi(clean_stand))
  9.     replace clean_stand = . if !has_clean
 10.     gen byte multiday_work = (work==1 & multiday_job==1)
 11.     gen byte mwflag = multiday_work if work==1
 12.     preserve
 13.         keep if work==1
 14.         sort pid date
 15.         by pid: gen byte lag_mw = mwflag[_n-1]
 16.         by pid: gen long spellstart = (mwflag==1 & (lag_mw!=1 | mi(lag_mw)))
 17.         by pid: gen long spell_id = sum(spellstart) if mwflag==1
 18.         by pid: gen byte prevwork_clean = clean_stand[_n-1]
 19.         keep pid date spell_id spellstart prevwork_clean
 20.         tempfile sp
 21.         save `sp'
 22.     restore
 23.     merge 1:1 pid date using `sp', nogen
 24.     preserve
 25.         keep if spellstart==1
 26.         keep pid spell_id prevwork_clean
 27.         rename prevwork_clean anchor_clean
 28.         tempfile an
 29.         save `an'
 30.     restore
 31.     merge m:1 pid spell_id using `an', nogen keep(1 3)
 32.     gen byte job_at_stand = clean_stand
 33.     replace  job_at_stand = anchor_clean if multiday_work==1 & !mi(anchor_clean)
 34.     replace  job_at_stand = . if grid==0
 35. end

. 
