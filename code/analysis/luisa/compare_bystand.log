. program drop _all

. program define build_shock
  1.         preserve
  2.                 keep if phase == 2
  3.                 set type double
  4.                 collapse (sum) w_sum = resid_day_attendph2 ///
>                          (count) w_n = resid_day_attendph2 ///
>                          (first) standid, by(calendar_week pid treat)
  5.                 bysort standid calendar_week: egen sw_sum = total(w_sum)
  6.                 bysort standid calendar_week: egen sw_n   = total(w_n)
  7.                 sort pid calendar_week
  8.                 gen double avg_wkattend_loo = (sw_sum - w_sum) / (sw_n - w_n)
  9.                 bys pid calendar_week: keep if _n == 1
 10.                 sum avg_wkattend_loo, d
 11.                 scalar pct_j_attend = r(p25)
 12.                 keep pid calendar_week avg_wkattend_loo
 13.                 gen dow = 2
 14.                 tempfile loo
 15.                 save `loo'
 16.         restore
 17.         merge m:1 pid calendar_week using `loo', keep(1 2 3) nogen
 18.         gen wkof_attend_j = (avg_wkattend_loo <= pct_j_attend) if avg_wkattend_loo!=.
 19.         gen calwk_of_shock = stand_ph_calweek if wkof_attend_j==1
 20.         bys pid : egen firstofshock_calwk_j = min(calwk_of_shock)
 21.         drop calwk_of_shock
 22.         gen wks_since_shock_j = stand_ph_calweek - firstofshock_calwk_j
 23.         replace wks_since_shock_j = . if firstofshock_calwk_j == .
 24.         gen firstwk_attend_j = (wks_since_shock_j == 0)
 25.         gen post_attend_j    = (wks_since_shock_j > 0 & !mi(wks_since_shock_j))
 26. end

. 
. 
. program define prelim
  1.         use "$main_data" , clear
  2.         gen treat = treatment
  3.         egen standid = group(stand)
  4.         sort standid phase calendar_week date pid
  5.         by standid phase calendar_week: gen stand_ph_calweek_id1 = 1 if _n==1
  6.         egen temp2 = seq() if stand_ph_calweek_id1 == 1, by(standid phase)
  7.         egen stand_ph_calweek = max(temp2), by(standid phase calendar_week)
  8.         drop temp*
  9. 
.         * Number of unique control workers per stand (constant within stand)
.         preserve
 10.                 keep if phase==2 & treat==0
 11.                 bys standid pid: keep if _n==1
 12.                 bys standid: gen n_controls_stand = _N
 13.                 bys standid: keep if _n==1
 14.                 keep standid n_controls_stand
 15.                 tempfile sizes
 16.                 save `sizes'
 17.         restore
 18.         merge m:1 standid using `sizes', nogen
 19. 
.         * Same for treated, for context
.         preserve
 20.                 keep if phase==2 & treat==1
 21.                 bys standid pid: keep if _n==1
 22.                 bys standid: gen n_treated_stand = _N
 23.                 bys standid: keep if _n==1
 24.                 keep standid n_treated_stand
 25.                 tempfile szT
 26.                 save `szT'
 27.         restore
 28.         merge m:1 standid using `szT', nogen
 29. end

. 
