. foreach f in 03_phase1_completed_cleaned 03_phase2_completed_cleaned 05_phase1_phase2_makepanel {
  2.     di "============================================================"
  3.     di "FILE: `f'.dta"
  4.     di "============================================================"
  5.     use "$temp/`f'.dta", clear
  6.     di "  (n vars = " c(k) ")"
  7.     foreach v of varlist _all {
  8.         local lab : variable label `v'
  9.         local lname = lower("`v'")
 10.         local llab  = lower("`lab'")
 11.         foreach k of local kw {
 12.             if strpos("`lname'","`k'") | strpos("`llab'","`k'") {
 13.                 di "  `v'  |  `lab'"
 14.                 continue, break
 15.             }
 16.         }
 17.     }
 18. }
