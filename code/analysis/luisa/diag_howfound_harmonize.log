. *================================================================*
. * A reusable program: harmonize one v2 howfound var to v1 scheme
. *================================================================*
. capture program drop hf_v2_to_v1

. program define hf_v2_to_v1
  1.     * args: 1=source v2 var, 2=new harmonized var name
.     args src out
  2.     recode `src' (1 2 = 1)(3 4 = 2)(5 6 = 3)(7 = 4)(8 9 = 6)(10 = 7)(11 = 8) ///
>                  (998 = 998)(999 = 999), gen(`out')
  3. end

. 
. *================================================================*
. * Build harmonized combine on raw phase-2 (has v1 AND v2 per slot)
. *================================================================*
. use "$temp/03_phase2_completed_cleaned.dta", clear

. 
. local n_v2src   0     // # slot-rows sourced from v2

. local n_naive_amb 0   // v2-sourced rows whose RAW v2 code is 5/6/7 (ambiguous in naive)

. local n_standflip 0   // v2-sourced rows where naive=stand but harmonized=not-stand (or vice versa)

. local n_code5_md  0   // v2-sourced rows with raw code 5 (naive would read as multiday)

. 
. forval i = 1/7 {
  2.     cap confirm variable f_howfound_`i'
  3.     if _rc continue
  4.     cap confirm variable f_howfound_v2_`i'
  5.     if _rc continue
  6. 
.     * (1) provenance flag
.     gen byte hf_version_`i' = .
  7.     replace  hf_version_`i' = 1 if !mi(f_howfound_`i')
  8.     replace  hf_version_`i' = 2 if mi(f_howfound_`i') & !mi(f_howfound_v2_`i')
  9. 
.     * (2a) NAIVE combine (current line 179): raw v2 poured in
.     gen hf_naive_`i' = f_howfound_`i'
 10.     replace hf_naive_`i' = f_howfound_v2_`i' if mi(hf_naive_`i')
 11. 
.     * (2b) HARMONIZED combine: remap v2 -> v1 scheme first
.     hf_v2_to_v1 f_howfound_v2_`i' hf_v2map_`i'
 12.     gen hf_harm_`i' = f_howfound_`i'
 13.     replace hf_harm_`i' = hf_v2map_`i' if mi(hf_harm_`i')
 14. 
.     * ---- validation tallies (only on v2-sourced rows) ----
.     qui count if hf_version_`i'==2
 15.     local n_v2src = `n_v2src' + r(N)
 16.     qui count if hf_version_`i'==2 & inlist(hf_naive_`i',5,6,7)
 17.     local n_naive_amb = `n_naive_amb' + r(N)
 18.     qui count if hf_version_`i'==2 & hf_naive_`i'==5
 19.     local n_code5_md = `n_code5_md' + r(N)
 20.     * stand status under each: stand = codes {6,7,8,9,10,11}
.     gen byte st_naive_`i' = inlist(hf_naive_`i',6,7,8,9,10,11) if !mi(hf_naive_`i')
 21.     gen byte st_harm_`i'  = inlist(hf_harm_`i', 6,7,8,9,10,11) if !mi(hf_harm_`i')
 22.     qui count if hf_version_`i'==2 & st_naive_`i'!=st_harm_`i' & !mi(st_naive_`i') & !mi(st_harm_`i')
 23.     local n_standflip = `n_standflip' + r(N)
 24. }
