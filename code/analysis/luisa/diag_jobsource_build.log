. 
. foreach W in 1 3 7 14 9999 {
  2.     di "================ WINDOW W=`W' calendar days ================"
  3.     * for each multiday-work day, we want anchor at spell level:
.     * find nearest prior clean-source day before sstart within W days
.     gen byte anchor_stand_`W' = .
  4. 
.     * candidate clean days: has_clean==1
.     * We'll loop over spells via a join trick:
.     preserve
  5.         keep if has_clean==1
  6.         keep pid date clean_stand
  7.         rename date cdate
  8.         rename clean_stand csrc
  9.         tempfile clean
 10.         save `clean'
 11.     restore
 12. 
.     * spell-start rows
.     preserve
 13.         keep if spellstart==1
 14.         keep pid spell_id sstart
 15.         joinby pid using `clean'
 16.         keep if cdate < sstart & (sstart - cdate) <= `W'
 17.         * nearest prior: max cdate per spell
.         bys pid spell_id (cdate): keep if _n==_N
 18.         keep pid spell_id csrc
 19.         rename csrc anchor_val_`W'
 20.         tempfile anc
 21.         save `anc'
 22.     restore
 23.     merge m:1 pid spell_id using `anc', nogen keep(1 3)
 24.     replace anchor_stand_`W' = anchor_val_`W' if multiday_work==1 & !mi(sp
> ell_id)
 25.     cap drop anchor_val_`W'
 26. 
.     qui count if multiday_work==1
 27.     local denom = r(N)
 28.     qui count if multiday_work==1 & !mi(anchor_stand_`W')
 29.     local num = r(N)
 30.     di "  multiday work days = `denom'; attributed = `num' (" %4.1f 100*`n
> um'/`denom' "%)"
 31.     tab anchor_stand_`W' if multiday_work==1, missing
 32. }
