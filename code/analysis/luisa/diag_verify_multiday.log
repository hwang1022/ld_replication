. *=== B. Reproduce the combine fallback to COUNT contaminated days ===
. * Mirror 3_combine logic for howfound + multiday across the 7 grid slots,
. * tracking provenance (v1 vs v2) so we can flag misclassification.
. use "$temp/03_phase2_completed_cleaned.dta", clear

. rename f_* d_*

. 
. local bad_total 0

. local md5_total 0

. forval i = 1/7 {
  2.     cap confirm variable d_howfound_`i'
  3.     if _rc continue
  4.     * provenance: this slot's howfound will be taken from v2 iff v1 missin
> g & v2 present
.     gen byte v2src_`i' = mi(d_howfound_`i') & !mi(d_howfound_v2_`i')
  5.     * combined howfound (mirror line 179)
.     gen hf_`i' = d_howfound_`i'
  6.     replace hf_`i' = d_howfound_v2_`i' if mi(hf_`i')
  7.     * explicit multiday question for this slot (may not exist in v2)
.     * combined multiday per line 258-260 (notattend not in phase2 grid the sa
> me way; approximate)
.     gen byte md_`i' = d_multiday_job_`i'
  8.     replace md_`i' = (hf_`i'==5) if mi(md_`i') & !mi(hf_`i')
  9.     * CONTAMINATION: md set to 1 via the ==5 fallback on a v2-sourced row
.     *   (v2 code 5 = phone-friend, NOT multiday)
.     gen byte bad_`i' = (md_`i'==1 & v2src_`i'==1 & mi(d_multiday_job_`i') & h
> f_`i'==5)
 10.     qui count if bad_`i'==1
 11.     local b = r(N)
 12.     qui count if hf_`i'==5 & md_`i'==1
 13.     local m = r(N)
 14.     di "slot `i': multiday-by-code5 = `m';  of which v2 phone-friend MISFL
> AGGED = `b'"
 15.     local bad_total = `bad_total' + `b'
 16.     local md5_total = `md5_total' + `m'
 17. }
